# Production collector read-only API key
COLLECTOR_API_KEY=replace-with-a-long-random-value
COLLECTOR_SOURCE_HOST=rpi-smarthome

# Production upstreams
COLLECTOR_INGESTION_METRICS_URL=http://ingest:9090/metrics
COLLECTOR_INGESTION_CACHE_URL=http://ingest:8085

# Docker service names the production collector may inspect
COLLECTOR_ALLOWED_SERVICES=nanomq,ingestion-service,influxdb,telegraf,grafana,device-management,control-ui,homekit-api
COLLECTOR_HTTP_TIMEOUT_SECONDS=5
COLLECTOR_MAX_LOG_LINES=1000

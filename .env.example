# production or simulation
COLLECTOR_MODE=simulation

# read-only collector api-key
COLLECTOR_API_KEY=replace-with-a-long-random-value

COLLECTOR_SOURCE_HOST=local-simulation

# URLs reachable from inside the collector container
COLLECTOR_INGESTION_METRICS_URL=http://ingest:9090/metrics
COLLECTOR_INGESTION_CACHE_URL=http://ingest:8085

# docker compose service names the collector may inspect
COLLECTOR_ALLOWED_SERVICES=nanomq,ingestion-service,influxdb,telegraf,grafana,device-management,control-ui,homekit-api

COLLECTOR_HTTP_TIMEOUT_SECONDS=5
COLLECTOR_MAX_LOG_LINES=1000

# simulation settings
COLLECTOR_SIMULATION_SEED=42
COLLECTOR_SIMULATION_PROFILE_PATH=config/simulation-profile.json
COLLECTOR_SIMULATION_DEVICE_ID=esp32-simulated-01
COLLECTOR_SIMULATION_RUNTIME_ENABLED=true
COLLECTOR_SIMULATION_ADMIN_API_KEY=replace-with-a-different-long-random-value
COLLECTOR_SIMULATION_SCENARIO_PATH=config/scenarios
